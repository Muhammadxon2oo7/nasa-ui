# FastAPI backend (nasa_agro). The browser calls /py/* and Next.js proxies it here.
BACKEND_URL=https://agro-nasa-api.e-investment.uz
# true = use the FastAPI backend for /analyze (falls back to the built-in Next.js API if it fails)
NEXT_PUBLIC_USE_FASTAPI=true
# Optional: a different base URL for the built-in API (leave empty)
NEXT_PUBLIC_API_URL=
# true = never call a backend, only /demo JSON
NEXT_PUBLIC_DEMO_MODE=false
# server file cache directory
CACHE_DIR=.cache
